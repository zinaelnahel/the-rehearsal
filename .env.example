# Demo chat is offline. Enabling speech separately sends audio externally after consent.
REHEARSAL_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# In-memory request ceiling across the single backend instance; resets on restart.
MODEL_CALLS_PER_HOUR=200

# Agent preparation adds up to two bounded tool-selection calls per live turn.
REHEARSAL_AGENT_ENABLED=true
# Disk-backed source text/vectors, not conversation history. Use memory for offline tests.
VECTOR_STORE=chroma
CHROMA_PATH=.runtime/chroma
# Requires FFmpeg on PATH (included in Docker), OPENAI_API_KEY, and per-use consent.
# Demo chat stays offline; explicitly enabling speech still makes external audio calls.
SPEECH_ENABLED=false
# Optional YouTube caption fallback. Backend only; existing captions/native mode.
# Leave empty to use only the direct importer. Never use a NEXT_PUBLIC_ key.
SUPADATA_API_KEY=
# Only the synthetic evaluation runner enables tracing; normal sessions stay untraced.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=the-rehearsal-evaluation
# Optional: use your workspace's regional endpoint.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Vercel frontend: public HTTPS address of the separate backend (server-only).
# Locally defaults to http://127.0.0.1:8000.
# BACKEND_URL=https://your-backend.onrender.com
# Set the SAME random secret on both hosts to block direct access to the API.
# API_PROXY_TOKEN=

# Optional local deployment credentials; never upload or commit this file's real values.
# Render dashboard -> Account Settings -> API Keys.
# RENDER_API_KEY=
# GitHub repository URL containing this project, for Render's source build.
# DEPLOY_REPO_URL=https://github.com/your-account/the-rehearsal

# Single-backend admission controls (also protect demo/import endpoints).
API_REQUESTS_PER_MINUTE=300
API_MAX_CONCURRENT=12

# Persistent conservative reservations for all paid AI/caption requests.
# Failed requests consume their reservation. UTC day boundary; no user data stored.
PROVIDER_DAILY_BUDGET_USD=10
PROVIDER_CALL_RESERVATION_USD=0.10
PROVIDER_BUDGET_PATH=.runtime/provider-budget.sqlite3
MODEL_MAX_INPUT_BYTES=160000
# Docker requires Linux Landlock ABI >=3 and libseccomp; fails closed if unavailable.
# On local non-Linux development leave unset for bounded process-only parsing.
# PARSER_SANDBOX=required

API_CLIENT_REQUESTS_PER_MINUTE=30
# Docker sets PUBLIC_DEPLOYMENT=true and requires both proxy secret and sandbox.
