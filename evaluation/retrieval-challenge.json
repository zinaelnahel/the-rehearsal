  "corpora": [
    {
      "id": "english",
      "language": "English",
      "passages": [
        {
          "id": "rent",
          "text": "The monthly rent is 850 euros, payable at the beginning of each month."
        },
        {
          "id": "availability",
          "text": "The apartment is available from 1 December. The tenant can collect the keys on that date."
        },
        {
          "id": "pets",
          "text": "Tenants may keep cats and dogs in the apartment. Other animals require written permission."
        },
        {
          "id": "deposit",
          "text": "A refundable security deposit of 1700 euros is required before moving in. It is separate from monthly rent."
        },
        {
          "id": "accessibility",
          "text": "There are no entrance steps, and a lift reaches the apartment. A wheelchair can pass through the front door."
        },
        {
          "id": "internet",
          "text": "Fibre broadband is installed with a download speed of 300 megabits per second, suitable for video calls from home."
        },
        {
          "id": "parking",
          "text": "One underground parking space is available for an additional 70 euros per month."
        },
        {
          "id": "utilities",
          "text": "Electricity and water are billed separately according to consumption. Heating is included in the rent."
        },
        {
          "id": "furniture",
          "text": "The bedroom contains a bed and a wardrobe. The living room is unfurnished."
        },
        {
          "id": "viewing",
          "text": "Apartment viewings take place on Tuesday afternoons by appointment. Contact the agent to book a viewing."
        },
        {
          "id": "transport",
          "text": "The tram stop is five minutes away on foot. The number 4 tram travels to the city centre."
        },
        {
          "id": "park",
          "text": "There is a public dog park across the street. It has a fenced exercise area and drinking fountains."
        },
        {
          "id": "storage",
          "text": "Residents can store bicycles in a locked basement room. Large furniture cannot be stored there."
        },
        {
          "id": "documents",
          "text": "Applicants need identification and their last three payslips. No bank password is requested."
        },
        {
          "id": "lease",
          "text": "The rental agreement initially runs for twelve months. Renewal can be discussed before the contract ends."
        },
        {
          "id": "payment",
          "text": "Payments are made by bank transfer. The agent provides the account details after the agreement is signed."
        }
      ]
    },
    {
      "id": "german",
      "language": "German",
      "passages": [
        {
          "id": "rent",
          "text": "Die monatliche Miete beträgt 850 Euro und ist zu Beginn jedes Monats fällig."
        },
        {
          "id": "availability",
          "text": "Die Wohnung ist ab dem 1. Dezember verfügbar. An diesem Tag können die Schlüssel abgeholt werden."
        },
        {
          "id": "pets",
          "text": "Mieter dürfen Katzen und Hunde in der Wohnung halten. Andere Tiere benötigen eine schriftliche Erlaubnis."
        },
        {
          "id": "deposit",
          "text": "Vor dem Einzug ist eine rückzahlbare Kaution von 1700 Euro erforderlich. Sie ist von der monatlichen Miete getrennt."
        },
        {
          "id": "accessibility",
          "text": "Der Eingang ist stufenlos und ein Aufzug führt zur Wohnung. Ein Rollstuhl passt durch die Eingangstür."
        },
        {
          "id": "internet",
          "text": "Ein Glasfaseranschluss mit 300 Megabit pro Sekunde ist installiert und für Videoanrufe von zu Hause geeignet."
        },
        {
          "id": "parking",
          "text": "Ein Tiefgaragenstellplatz ist für zusätzliche 70 Euro pro Monat verfügbar."
        },
        {
          "id": "utilities",
          "text": "Strom und Wasser werden nach Verbrauch separat abgerechnet. Die Heizung ist in der Miete enthalten."
        },
        {
          "id": "furniture",
          "text": "Im Schlafzimmer stehen ein Bett und ein Kleiderschrank. Das Wohnzimmer ist unmöbliert."
        },
        {
          "id": "viewing",
          "text": "Wohnungsbesichtigungen finden dienstagnachmittags nach Vereinbarung statt. Termine werden mit dem Makler vereinbart."
        },
        {
          "id": "transport",
          "text": "Die Straßenbahnhaltestelle ist zu Fuß fünf Minuten entfernt. Die Linie 4 fährt ins Stadtzentrum."
        },
        {
          "id": "park",
          "text": "Auf der anderen Straßenseite liegt ein öffentlicher Hundepark mit eingezäunter Auslauffläche und Trinkbrunnen."
        },
        {
          "id": "storage",
          "text": "Bewohner können Fahrräder in einem abgeschlossenen Kellerraum abstellen. Große Möbel dürfen dort nicht gelagert werden."
        },
        {
          "id": "documents",
          "text": "Bewerber benötigen einen Ausweis und die letzten drei Gehaltsabrechnungen. Es wird kein Bankpasswort verlangt."
        },
        {
          "id": "lease",
          "text": "Der Mietvertrag läuft zunächst zwölf Monate. Eine Verlängerung kann vor Vertragsende besprochen werden."
        },
        {
          "id": "payment",
          "text": "Zahlungen erfolgen per Banküberweisung. Die Kontodaten werden nach der Vertragsunterzeichnung mitgeteilt."
        }
      ]
    },
    {
      "id": "spanish",
      "language": "Spanish",
      "passages": [
        {
          "id": "rent",
          "text": "El alquiler mensual es de 850 euros y se paga al comienzo de cada mes."
        },
        {
          "id": "availability",
          "text": "El piso está disponible a partir del 1 de diciembre. Las llaves se pueden recoger ese día."
        },
        {
          "id": "pets",
          "text": "Los inquilinos pueden tener gatos y perros en el piso. Otros animales requieren autorización por escrito."
        },
        {
          "id": "deposit",
          "text": "Antes de entrar se requiere una fianza reembolsable de 1700 euros. Es independiente del alquiler mensual."
        },
        {
          "id": "accessibility",
          "text": "La entrada no tiene escalones y un ascensor llega al piso. Una silla de ruedas cabe por la puerta principal."
        },
        {
          "id": "internet",
          "text": "Hay fibra óptica instalada de 300 megabits por segundo, adecuada para videollamadas desde casa."
        },
        {
          "id": "parking",
          "text": "Hay una plaza de garaje subterránea por 70 euros adicionales al mes."
        },
        {
          "id": "utilities",
          "text": "La electricidad y el agua se facturan aparte según el consumo. La calefacción está incluida en el alquiler."
        },
        {
          "id": "furniture",
          "text": "El dormitorio tiene una cama y un armario. El salón no está amueblado."
        },
        {
          "id": "viewing",
          "text": "Las visitas al piso son los martes por la tarde con cita previa. Contacta con la agencia para reservar."
        },
        {
          "id": "transport",
          "text": "La parada de tranvía está a cinco minutos a pie. La línea 4 va al centro de la ciudad."
        },
        {
          "id": "park",
          "text": "Al otro lado de la calle hay un parque canino público con zona vallada y fuentes de agua."
        },
        {
          "id": "storage",
          "text": "Los residentes pueden guardar bicicletas en un cuarto cerrado del sótano. No se permiten muebles grandes allí."
        },
        {
          "id": "documents",
          "text": "Los solicitantes necesitan identificación y las tres últimas nóminas. No se pide ninguna contraseña bancaria."
        },
        {
          "id": "lease",
          "text": "El contrato de alquiler dura inicialmente doce meses. Se puede hablar de renovarlo antes de que termine."
        },
        {
          "id": "payment",
          "text": "Los pagos se hacen por transferencia bancaria. La agencia facilita los datos de la cuenta después de firmar."
        }
      ]
    }
